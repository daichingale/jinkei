# # 吹奏楽連盟マーチングコンテストの規定課題を、パレード自動作成で作ったショー（体育館 30m×30m）
# # ①四角形ラインを反時計回りに一周（順次ピンホイール 8 拍）→ ②センターラインで180°ターン（カウンターマーチ）→ ③客席向きで32歩足踏み
# # 先頭はドラムメジャー（dm）。直進は縦横そろった直線、角は拍を決めて回る。外側の列は20mラインの外側を通る
show "マーチングコンテスト規定課題（36人）" {
  field gym
  tempo 120

  section fl "フルート" 6 color "#ff9ff3"
  section tp "トランペット" 8 color "#ffd23f"
  section cl "クラリネット" 8 color "#48dbfb"
  section tb "トロンボーン" 6 color "#ee5253"
  section sn "スネア" 4 instrument snare color "#ff9f43"
  section bd "バスドラム" 3 instrument bass_drum color "#c8d6e5"
  section dm "ドラムメジャー" 1 color "#e63946"

  set 整列 {
    fl1..fl3       : line (2.1875, -8.75) -> (2.1875, -11.25) assign keep step glide
    fl4..fl6       : line (0.9375, -8.75) -> (0.9375, -11.25) assign keep step glide
    tp1..tp3       : line (-0.3125, -8.75) -> (-0.3125, -11.25) assign keep step glide
    tp4..tp6       : line (-1.5625, -8.75) -> (-1.5625, -11.25) assign keep step glide
    tp7..tp8 + cl1 : line (-2.8125, -8.75) -> (-2.8125, -11.25) assign keep step glide
    cl2..cl4       : line (-4.0625, -8.75) -> (-4.0625, -11.25) assign keep step glide
    cl5..cl7       : line (-5.3125, -8.75) -> (-5.3125, -11.25) assign keep step glide
    cl8 + tb1..tb2 : line (-6.5625, -8.75) -> (-6.5625, -11.25) assign keep step glide
    tb3..tb5       : line (-7.8125, -8.75) -> (-7.8125, -11.25) assign keep step glide
    tb6 + sn1..sn2 : line (-9.0625, -8.75) -> (-9.0625, -11.25) assign keep step glide
    sn3..sn4 + bd1 : line (-10.3125, -8.75) -> (-10.3125, -11.25) assign keep step glide
    bd2..bd3       : line (-11.5625, -8.75) -> (-11.5625, -10) assign keep step glide
    dm             : at (4.6875, -10) step glide
  }

  set "①1" counts 4 {   # 直進
    all : same shift (2.5, 0) step glide
  }

  set sub counts 4 {
    fl + tp + cl + tb + sn + bd : same shift (2.5, 0) step glide
    dm                          : same rotate 45 about (7.1875, -7.1875) bend -45 step glide
  }

  set "①2" counts 2 {   # 先頭が①角1でピンホイール
    fl1..fl3 + dm                     : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    fl4..fl6 + tp + cl + tb + sn + bd : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + dm                : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    tp + cl + tb + sn + bd : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3                : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    tp4..tp8 + cl + tb + sn + bd : same shift (1.25, 0) step glide
    dm                           : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6                : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    tp7..tp8 + cl + tb + sn + bd : same shift (1.25, 0) step glide
    dm                           : same shift (0, 1.25) step glide
  }

  set "①3" counts 2 {   # 直進
    fl1..fl3 + dm           : same shift (0, 1.25) step glide
    fl4..fl6 + tp + cl1     : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    cl2..cl8 + tb + sn + bd : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + dm                 : same shift (0, 1.25) step glide
    tp + cl1..cl4           : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    cl5..cl8 + tb + sn + bd : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3 + dm  : same shift (0, 1.25) step glide
    tp4..tp8 + cl1..cl7 : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    cl8 + tb + sn + bd  : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6 + dm       : same shift (0, 1.25) step glide
    tp7..tp8 + cl + tb1..tb2 : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    tb3..tb6 + sn + bd       : same shift (1.25, 0) step glide
  }

  set "①4" counts 2 {   # 直進
    fl + tp + cl1 + dm  : same shift (0, 1.25) step glide
    cl2..cl8 + tb1..tb5 : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    tb6 + sn + bd       : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl4 + dm  : same shift (0, 1.25) step glide
    cl5..cl8 + tb + sn1..sn2 : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    sn3..sn4 + bd            : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl7 + dm : same shift (0, 1.25) step glide
    cl8 + tb + sn + bd1     : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    bd2..bd3                : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb1..tb2 + dm : same shift (0, 1.25) step glide
    tb3..tb6 + sn + bd           : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
  }

  set "①5" counts 2 {   # 最後尾が①角1を回り終える、先頭が①角2でピンホイール
    fl + tp + cl + tb1..tb5 + dm : same shift (0, 1.25) step glide
    tb6 + sn + bd                : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn1..sn2 + dm : same shift (0, 0.625) step glide
    sn3..sn4 + bd                     : same rotate 11.25 about (7.1875, -7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn1..sn2 : same shift (0, 0.625) step glide
    sn3..sn4 + bd                : same rotate 11.25 about (7.1875, -7.1875) bend -11.25 step glide
    dm                           : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb + sn + bd1 : same shift (0, 1.25) step glide
    bd2..bd3                     : same rotate 22.5 about (7.1875, -7.1875) bend -22.5 step glide
    dm                           : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn + bd : same shift (0, 0.625) step glide
    dm                          : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl1..fl3 + dm                     : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    fl4..fl6 + tp + cl + tb + sn + bd : same shift (0, 0.625) step glide
  }

  set "①6" counts 1 {   # 直進
    fl1..fl3 + dm                     : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    fl4..fl6 + tp + cl + tb + sn + bd : same shift (0, 0.625) step glide
  }

  set sub counts 2 {
    fl + dm                : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    tp + cl + tb + sn + bd : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3                : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    tp4..tp8 + cl + tb + sn + bd : same shift (0, 1.25) step glide
    dm                           : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6                : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    tp7..tp8 + cl + tb + sn + bd : same shift (0, 1.25) step glide
    dm                           : same shift (-1.25, 0) step glide
  }

  set sub counts 1 {
    fl1..fl3 + dm           : same shift (-0.625, 0) step glide
    fl4..fl6 + tp + cl1     : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    cl2..cl8 + tb + sn + bd : same shift (0, 0.625) step glide
  }

  set "①7" counts 1 {   # 直進
    fl1..fl3 + dm           : same shift (-0.625, 0) step glide
    fl4..fl6 + tp + cl1     : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    cl2..cl8 + tb + sn + bd : same shift (0, 0.625) step glide
  }

  set sub counts 2 {
    fl + dm                 : same shift (-1.25, 0) step glide
    tp + cl1..cl4           : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    cl5..cl8 + tb + sn + bd : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3 + dm  : same shift (-1.25, 0) step glide
    tp4..tp8 + cl1..cl7 : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    cl8 + tb + sn + bd  : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6 + dm       : same shift (-1.25, 0) step glide
    tp7..tp8 + cl + tb1..tb2 : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    tb3..tb6 + sn + bd       : same shift (0, 1.25) step glide
  }

  set sub counts 1 {
    fl + tp + cl1 + dm  : same shift (-0.625, 0) step glide
    cl2..cl8 + tb1..tb5 : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    tb6 + sn + bd       : same shift (0, 0.625) step glide
  }

  set "①8" counts 1 {   # 直進
    fl + tp + cl1 + dm  : same shift (-0.625, 0) step glide
    cl2..cl8 + tb1..tb5 : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    tb6 + sn + bd       : same shift (0, 0.625) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl4 + dm  : same shift (-1.25, 0) step glide
    cl5..cl8 + tb + sn1..sn2 : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    sn3..sn4 + bd            : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl7 + dm : same shift (-1.25, 0) step glide
    cl8 + tb + sn + bd1     : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    bd2..bd3                : same shift (0, 1.25) step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb1..tb2 + dm : same shift (-1.25, 0) step glide
    tb3..tb6 + sn + bd           : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb1..tb5 + dm : same shift (-0.625, 0) step glide
    tb6 + sn + bd                : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
  }

  set "①9" counts 1 {   # 最後尾が①角2を回り終える、先頭が①角3でピンホイール
    fl + tp + cl + tb1..tb5 + dm : same shift (-0.625, 0) step glide
    tb6 + sn + bd                : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn1..sn2 + dm : same shift (-0.625, 0) step glide
    sn3..sn4 + bd                     : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn1..sn2 : same shift (-0.625, 0) step glide
    sn3..sn4 + bd                : same rotate 11.25 about (7.1875, 7.1875) bend -11.25 step glide
    dm                           : same rotate 11.25 about (-7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb + sn + bd1 : same shift (-1.25, 0) step glide
    bd2..bd3                     : same rotate 22.5 about (7.1875, 7.1875) bend -22.5 step glide
    dm                           : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn + bd : same shift (-0.625, 0) step glide
    dm                          : same rotate 11.25 about (-7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl1..fl3 + dm                     : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    fl4..fl6 + tp + cl + tb + sn + bd : same shift (-1.25, 0) step glide
  }

  set "①10" counts 2 {   # 直進
    fl + dm                : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    tp + cl + tb + sn + bd : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3                : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    tp4..tp8 + cl + tb + sn + bd : same shift (-1.25, 0) step glide
    dm                           : same shift (0, -1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6                : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    tp7..tp8 + cl + tb + sn + bd : same shift (-1.25, 0) step glide
    dm                           : same shift (0, -1.25) step glide
  }

  set sub counts 2 {
    fl1..fl3 + dm           : same shift (0, -1.25) step glide
    fl4..fl6 + tp + cl1     : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    cl2..cl8 + tb + sn + bd : same shift (-1.25, 0) step glide
  }

  set "①11" counts 2 {   # 直進
    fl + dm                 : same shift (0, -1.25) step glide
    tp + cl1..cl4           : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    cl5..cl8 + tb + sn + bd : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3 + dm  : same shift (0, -1.25) step glide
    tp4..tp8 + cl1..cl7 : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    cl8 + tb + sn + bd  : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6 + dm       : same shift (0, -1.25) step glide
    tp7..tp8 + cl + tb1..tb2 : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    tb3..tb6 + sn + bd       : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl1 + dm  : same shift (0, -1.25) step glide
    cl2..cl8 + tb1..tb5 : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    tb6 + sn + bd       : same shift (-1.25, 0) step glide
  }

  set "①12" counts 2 {   # 直進
    fl + tp + cl1..cl4 + dm  : same shift (0, -1.25) step glide
    cl5..cl8 + tb + sn1..sn2 : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    sn3..sn4 + bd            : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl7 + dm : same shift (0, -1.25) step glide
    cl8 + tb + sn + bd1     : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    bd2..bd3                : same shift (-1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb1..tb2 + dm : same shift (0, -1.25) step glide
    tb3..tb6 + sn + bd           : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb1..tb5 + dm : same shift (0, -1.25) step glide
    tb6 + sn + bd                : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
  }

  set "①13" counts 1 {   # 最後尾が①角3を回り終える、先頭が①角4でピンホイール
    fl + tp + cl + tb + sn1..sn2 + dm : same shift (0, -0.625) step glide
    sn3..sn4 + bd                     : same rotate 11.25 about (-7.1875, 7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn1..sn2 : same shift (0, -0.625) step glide
    sn3..sn4 + bd                : same rotate 11.25 about (-7.1875, 7.1875) bend -11.25 step glide
    dm                           : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb + sn + bd1 : same shift (0, -1.25) step glide
    bd2..bd3                     : same rotate 22.5 about (-7.1875, 7.1875) bend -22.5 step glide
    dm                           : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb + sn + bd : same shift (0, -0.625) step glide
    dm                          : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl1..fl3 + dm                     : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    fl4..fl6 + tp + cl + tb + sn + bd : same shift (0, -1.25) step glide
  }

  set sub counts 1 {
    fl + dm                : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    tp + cl + tb + sn + bd : same shift (0, -0.625) step glide
  }

  set "①14" counts 1 {   # 直進
    fl + dm                : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    tp + cl + tb + sn + bd : same shift (0, -0.625) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3                : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    tp4..tp8 + cl + tb + sn + bd : same shift (0, -1.25) step glide
    dm                           : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6                : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    tp7..tp8 + cl + tb + sn + bd : same shift (0, -1.25) step glide
    dm                           : same shift (1.25, 0) step glide
  }

  set sub counts 2 {
    fl1..fl3 + dm           : same shift (1.25, 0) step glide
    fl4..fl6 + tp + cl1     : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    cl2..cl8 + tb + sn + bd : same shift (0, -1.25) step glide
  }

  set sub counts 1 {
    fl + dm                 : same shift (0.625, 0) step glide
    tp + cl1..cl4           : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    cl5..cl8 + tb + sn + bd : same shift (0, -0.625) step glide
  }

  set "①15" counts 1 {   # 直進
    fl + dm                 : same shift (0.625, 0) step glide
    tp + cl1..cl4           : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    cl5..cl8 + tb + sn + bd : same shift (0, -0.625) step glide
  }

  set sub counts 2 {
    fl + tp1..tp3 + dm  : same shift (1.25, 0) step glide
    tp4..tp8 + cl1..cl7 : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    cl8 + tb + sn + bd  : same shift (0, -1.25) step glide
  }

  set sub counts 2 {
    fl + tp1..tp6 + dm       : same shift (1.25, 0) step glide
    tp7..tp8 + cl + tb1..tb2 : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    tb3..tb6 + sn + bd       : same shift (0, -1.25) step glide
  }

  set sub counts 2 {
    fl + tp + cl1 + dm  : same shift (1.25, 0) step glide
    cl2..cl8 + tb1..tb5 : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    tb6 + sn + bd       : same shift (0, -1.25) step glide
  }

  set sub counts 1 {
    fl + tp + cl1..cl4 + dm  : same shift (0.625, 0) step glide
    cl5..cl8 + tb + sn1..sn2 : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    sn3..sn4 + bd            : same shift (0, -0.625) step glide
  }

  set "①16" counts 1 {   # 先頭が出発位置に戻る（①おわり）
    fl + tp + cl1..cl4 + dm  : same shift (0.625, 0) step glide
    cl5..cl8 + tb + sn1..sn2 : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
    sn3..sn4 + bd            : same shift (0, -0.625) step glide
  }

  set sub counts 2 {
    fl + tp + cl1..cl7 + dm : same shift (1.25, 0) step glide
    cl8 + tb + sn + bd1     : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
    bd2..bd3                : same shift (0, -1.25) step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb1..tb2 + dm : same shift (0.625, 0) step glide
    tb3..tb6 + sn + bd           : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
  }

  set sub counts 1 {
    fl + tp + cl + tb1..tb2 + dm : same shift (0.625, 0) step glide
    tb3..tb6 + sn + bd           : same rotate 11.25 about (-7.1875, -7.1875) bend -11.25 step glide
  }

  set sub counts 2 {
    fl + tp + cl + tb1..tb5 + dm : same shift (1.25, 0) step glide
    tb6 + sn + bd                : same rotate 22.5 about (-7.1875, -7.1875) bend -22.5 step glide
