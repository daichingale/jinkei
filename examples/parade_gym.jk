# パレード自動作成で作ったショー: ウィールで体育館の外周を時計回りに一周
# 出発前に8カウント足踏み → 一周 → 整列して停止
show "パレード（体育館を一周）" {
  field gym
  tempo 120

  section fl "フルート" 6 color "#ff9ff3"
  section tp "トランペット" 8 color "#ffd23f"
  section cl "クラリネット" 8 color "#48dbfb"
  section sn "スネア" 4 instrument snare color "#ff9f43"

  set 整列 hold 8 {
    fl1..fl4            : line (0, -14.2) -> (0, -10.6) assign keep step glide
    fl5..fl6 + tp1..tp2 : line (1.685, -14.2) -> (1.685, -10.6) assign keep step glide
    tp3..tp6            : line (3.401, -14.197) -> (3.322, -10.598) assign keep step glide
    tp7..tp8 + cl1..cl2 : line (5.314, -13.988) -> (4.611, -10.457) assign keep step glide
    cl3..cl6            : line (7.161, -13.449) -> (5.857, -10.094) assign keep step glide
    cl7..cl8 + sn1..sn2 : line (8.887, -12.598) -> (7.02, -9.521) assign keep step glide
    sn3                 : at (9.648, -10.558) step glide
    sn4                 : at (8.857, -9.656) step glide
  }

  set 角1 counts 44 {   # コーナー
    fl1 : at (-13.614, 6.709) bend 125.214 step glide
    fl2 : at (-12.478, 6.323) bend 126.632 step glide
    fl3 : at (-11.341, 5.937) bend 128.269 step glide
    fl4 : at (-10.205, 5.552) bend 130.177 step glide
    fl5 : at (-14.072, 4.839) bend 127.914 step glide
    fl6 : at (-12.885, 4.657) bend 130.084 step glide
    tp1 : at (-11.699, 4.474) bend 132.591 step glide
    tp2 : at (-10.513, 4.292) bend 135.519 step glide
    tp3 : at (-14.2, 2.949) bend 128.464 step glide
    tp4 : at (-13, 2.949) bend 131.001 step glide
    tp5 : at (-11.8, 2.949) bend 133.906 step glide
    tp6 : at (-10.6, 2.949) bend 137.262 step glide
    tp7 : at (-14.2, 1.264) bend 127.446 step glide
    tp8 : at (-13, 1.264) bend 129.459 step glide
    cl1 : at (-11.8, 1.264) bend 131.788 step glide
    cl2 : at (-10.6, 1.264) bend 134.515 step glide
    cl3 : at (-14.2, -0.421) bend 124.202 step glide
    cl4 : at (-13, -0.421) bend 125.378 step glide
    cl5 : at (-11.8, -0.421) bend 126.725 step glide
    cl6 : at (-10.6, -0.421) bend 128.28 step glide
    cl7 : at (-14.2, -2.107) bend 118.904 step glide
    cl8 : at (-13, -2.107) bend 118.882 step glide
    sn1 : at (-11.8, -2.107) bend 118.754 step glide
    sn2 : at (-10.6, -2.107) bend 118.448 step glide
    sn3 : at (-12.979, -3.804) bend 110.323 step glide
    sn4 : at (-11.782, -3.725) bend 108.8 step glide
  }

  set 角2 counts 44 {   # コーナー
    fl1 : at (12.339, 9.293) bend 102.147 step glide
    fl2 : at (11.342, 8.627) bend 99.794 step glide
    fl3 : at (10.344, 7.96) bend 96.929 step glide
    fl4 : at (9.346, 7.293) bend 93.365 step glide
    fl5 : at (11.135, 10.794) bend 107.356 step glide
    fl6 : at (10.268, 9.964) bend 105.851 step glide
    tp1 : at (9.401, 9.135) bend 103.939 step glide
    tp2 : at (8.534, 8.305) bend 101.441 step glide
    tp3 : at (9.688, 12.063) bend 115.571 step glide
    tp4 : at (8.978, 11.095) bend 114.813 step glide
    tp5 : at (8.269, 10.128) bend 113.758 step glide
    tp6 : at (7.559, 9.16) bend 112.25 step glide
    tp7 : at (8.043, 13.061) bend 121.795 step glide
    tp8 : at (7.512, 11.985) bend 122.418 step glide
    cl1 : at (6.981, 10.909) bend 123.092 step glide
    cl2 : at (6.451, 9.833) bend 123.808 step glide
    cl3 : at (6.249, 13.759) bend 126.094 step glide
    cl4 : at (5.914, 12.607) bend 127.732 step glide
    cl5 : at (5.578, 11.455) bend 129.627 step glide
    cl6 : at (5.242, 10.303) bend 131.847 step glide
    cl7 : at (4.362, 14.134) bend 128.241 step glide
    cl8 : at (4.231, 12.942) bend 130.55 step glide
    sn1 : at (4.101, 11.749) bend 133.211 step glide
    sn2 : at (3.97, 10.556) bend 136.309 step glide
    sn3 : at (2.528, 13) bend 130.856 step glide
    sn4 : at (2.528, 11.8) bend 133.648 step glide
  }

  set 角3 counts 48 {   # コーナー
    fl1 : at (0, -14.2) bend 131.425 step glide
    fl2 : at (0, -13) bend 132.264 step glide
    fl3 : at (0, -11.8) bend 133.252 step glide
    fl4 : at (0, -10.6) bend 134.433 step glide
    fl5 : at (1.685, -14.2) bend 127.097 step glide
    fl6 : at (1.685, -13) bend 126.798 step glide
    tp1 : at (1.685, -11.8) bend 126.397 step glide
    tp2 : at (1.685, -10.6) bend 125.843 step glide
    tp3 : at (3.401, -14.197) bend 121.122 step glide
    tp4 : at (3.375, -12.998) bend 119.415 step glide
    tp5 : at (3.348, -11.798) bend 117.259 step glide
    tp6 : at (3.322, -10.598) bend 114.459 step glide
    tp7 : at (5.314, -13.988) bend 116.376 step glide
    tp8 : at (5.08, -12.811) bend 113.876 step glide
    cl1 : at (4.846, -11.634) bend 110.818 step glide
    cl2 : at (4.611, -10.457) bend 106.996 step glide
    cl3 : at (7.161, -13.449) bend 115.41 step glide
    cl4 : at (6.726, -12.331) bend 112.749 step glide
    cl5 : at (6.291, -11.213) bend 109.508 step glide
    cl6 : at (5.857, -10.094) bend 105.477 step glide
    cl7 : at (8.887, -12.598) bend 118.291 step glide
    cl8 : at (8.265, -11.572) bend 116.11 step glide
    sn1 : at (7.642, -10.546) bend 113.417 step glide
    sn2 : at (7.02, -9.521) bend 110.008 step glide
    sn3 : at (9.648, -10.558) bend 123.31 step glide
    sn4 : at (8.857, -9.656) bend 122.038 step glide
  }

  set 停止 hold 8 mark {   # 整列・停止
    all : face 0
  }

  part "パレードのビート" for sn {
    meter 4/4
    start 8
    repeat 18 {
      8: R l r l R l r l |
      8: R l r r L r l l |
    }
  }
}
