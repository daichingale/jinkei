show "p" {
  field gym
  tempo 100
  section sn "スネア" 4 instrument snare
  section bd "バスドラム" 5
  section cy "シンバル" 2 instrument cymbals_high
  section tp "トランペット" 3
  set A hold 4 { sn : line (-3, 0) -> (3, 0)  bd : line (-4, 4) -> (4, 4)  cy : line (-3, 8) -> (3, 8)  tp : line (-3, 12) -> (3, 12) }
  set 2 counts 12 { sn : line (-3, 2) -> (3, 2) }
  set "B C" counts 8 hold 4 tempo 80 { sn : line (-3, 3) -> (3, 3) }
  part "連" for sn { 32: 7[ R l r l r l r ] 16: 9[ r l r l r l r l r ] 4: 4[ R l r l ] 2[ R l ] |  }
}
